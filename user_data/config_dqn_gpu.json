        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "freqai": {
        "enabled": true,
        "purge_old_models": 3,
        "train_period_days": 45,
        "backtest_period_days": 7,
        "identifier": "DQN_GPU_RTX2070",
        "continual_learning": false,
        "write_metrics_to_disk": true,
        "live_retrain_hours": 12,
        "feature_parameters": {
            "include_timeframes": [
                "5m"
            ],
            "include_corr_pairlist": [],
            "label_period_candles": 20,
